# Copy this file to .env and fill in real values.
# .env is gitignored (see .gitignore) — it should never be committed.

# Only relevant if this repository moves under a GitHub organization account.
# gitleaks-action is free and requires no license for personal accounts, which
# is the current setup — see the secret-scan job in .github/workflows/ci.yml.
# GITLEAKS_LICENSE=

# No project currently reads environment variables — none exist yet. As a
# project lands under projects/<track>/<project-name>/ and needs its own
# secrets (an API key, a database URL, etc.), add them here with a comment
# saying which project uses them, so this file stays a real index rather than
# speculative filler.
